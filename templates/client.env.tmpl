# Per-client env template with 1Password placeholders. Resolved at deploy time
# via `op inject -i this.tmpl -o /tmp/<slug>.env`, then scp'd to the VPS as
# /opt/hermes-client/compose/.env (chmod 600).
#
# Usage in M1: not yet — M1 uses compose/.env.example values directly.
# Usage in M3: bin/deploy-client will switch to this template + op inject.

# --- identity (non-secret; filled by deploy-client) ---
COMPOSE_SLUG={{SLUG}}
FQDN={{FQDN}}
ACME_EMAIL={{ACME_EMAIL}}

# --- image pins ---
APP_IMAGE=ghcr.io/REPLACE-ME/hermes-pyme:m2-initial
APP_UPSTREAM=app:8080
SCHEDULER_IMAGE=mcuadros/ofelia:v0.3.13

# --- LLM credentials (1Password references) ---
OPENAI_API_KEY=op://hermes-clients/{{SLUG}}/openai/api-key
ANTHROPIC_API_KEY=op://hermes-clients/{{SLUG}}/anthropic/api-key

# --- Hermes runtime ---
HERMES_PROFILE={{SLUG}}
HERMES_LOG_LEVEL=info

# --- Optional integrations (uncomment per client) ---
# GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=op://hermes-clients/{{SLUG}}/google/client-id
# GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=op://hermes-clients/{{SLUG}}/google/client-secret
# GOOGLE_WORKSPACE_OAUTH_REFRESH_TOKEN=op://hermes-clients/{{SLUG}}/google/refresh-token

# IMAP_HOST=
# IMAP_USERNAME=
# IMAP_PASSWORD=op://hermes-clients/{{SLUG}}/imap/password

# AIRTABLE_API_KEY=op://hermes-clients/{{SLUG}}/airtable/api-key
# NOTION_API_KEY=op://hermes-clients/{{SLUG}}/notion/api-key

# --- Backup (M4) ---
# BACKUP_AGE_RECIPIENT=op://hermes-clients/{{SLUG}}/backup/age-public
# BACKUP_B2_KEY_ID=op://hermes-clients/{{SLUG}}/backup/b2-key-id
# BACKUP_B2_APPLICATION_KEY=op://hermes-clients/{{SLUG}}/backup/b2-application-key
# BACKUP_B2_BUCKET=hermes-backups-prod
