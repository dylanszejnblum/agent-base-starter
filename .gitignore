# --- secrets and local state ---
*.env
!*.env.example
.envrc
.deploy-credentials/
*.pem
*.key
!**/Caddyfile*.tmpl

# secrets/ is tracked, but only encrypted .age files + .recipients + docs.
# Plaintext .env files in there are blocked.
secrets/*
!secrets/README.md
!secrets/.env.example
!secrets/.recipients
!secrets/*.env.age

# --- Terraform ---
infra/.terraform/
infra/.terraform.lock.hcl
infra/terraform.tfstate
infra/terraform.tfstate.*
infra/terraform.tfvars
!infra/terraform.tfvars.example
infra/backend.tf
!infra/backend.tf.example
infra/crash.log
infra/crash.*.log
infra/.terraformrc
infra/terraform.rc

# --- compose / runtime ---
compose/.env
compose/Caddyfile
compose/data/

# --- operating system ---
.DS_Store
Thumbs.db

# --- editor ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- build artifacts ---
dist/
build/
*.tar.gz
*.tgz

# --- inventory append working files ---
docs/client-inventory.local.md
