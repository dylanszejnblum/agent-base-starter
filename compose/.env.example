# Compose env file. On the VPS this lives at /opt/hermes-client/compose/.env
# (chmod 600, owned by deploy). Never commit the real file.

# --- identity ---
COMPOSE_SLUG=demo
FQDN=demo.example.com
ACME_EMAIL=ops@example.com

# --- image pins ---
# M1 uses whoami; M2 replaces with ghcr.io/<org>/hermes-pyme:<tag>
APP_IMAGE=traefik/whoami:v1.10
APP_UPSTREAM=app:80

# M2+
# SCHEDULER_IMAGE=mcuadros/ofelia:v0.3.13

# --- LLM / Hermes runtime (M2+) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# HERMES_PROFILE=demo
