# Compose env file. On the VPS this lives at /opt/hermes-client/compose/.env
# (chmod 600, owned by deploy). Never commit the real file.
#
# bin/deploy-client renders this file from templates/client.env.tmpl at deploy
# time. This .example exists for local dev (`docker compose -f ... -f
# docker-compose.local.yml up`) and for documentation.

# --- identity ---
COMPOSE_SLUG=demo
FQDN=demo.example.com
ACME_EMAIL=ops@example.com

# --- hermes image ---
# Default: Nous's published image, `main` tag. Pin to a SHA tag for prod.
# Pinned tags look like: nousresearch/hermes-agent:sha-d9b6f75c0b0ffa3cdb3cbe63de3a8e1a5aa44e8f
HERMES_IMAGE=nousresearch/hermes-agent:main

# UID/GID the in-container hermes user remaps to. 10000 matches the image
# default; only change if your host needs a specific UID for volume sharing.
HERMES_UID=10000
HERMES_GID=10000

# Profile name to create at first boot. Usually equals COMPOSE_SLUG.
HERMES_PROFILE=demo

# --- dashboard auth ---
# Generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
HERMES_DASHBOARD_USERNAME=ops
HERMES_DASHBOARD_PASSWORD_HASH=$2a$14$REPLACE.WITH.OUTPUT.OF.caddy.hash-password

# --- LLM provider keys ---
# At least one provider must be set for the agent to actually call models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
