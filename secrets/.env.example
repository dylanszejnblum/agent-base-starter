# Schema for a decrypted secrets/<slug>.env.age file.
# This file is the plaintext form — never used directly; `bin/deploy-client`
# decrypts <slug>.env.age into a temporary file with this shape.

# --- dashboard auth ---
# Plaintext password. bcrypt-hashed at deploy time before being shipped to the VPS.
HERMES_DASHBOARD_PASSWORD=replace-with-a-strong-password

# --- LLM provider keys (at least one required) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=

# --- Optional client integrations (per-client basis) ---
# GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=
# GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=
# GOOGLE_WORKSPACE_OAUTH_REFRESH_TOKEN=

# IMAP_HOST=
# IMAP_USERNAME=
# IMAP_PASSWORD=

# --- Hermes gateway integrations (Hermes-native: Slack, Telegram, Discord, etc.) ---
# SLACK_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=

# --- Backup (M4) ---
# BACKUP_AGE_RECIPIENT=
# BACKUP_B2_KEY_ID=
# BACKUP_B2_APPLICATION_KEY=
# BACKUP_B2_BUCKET=
