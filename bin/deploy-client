#!/usr/bin/env bash
# Single-command deploy. Orchestrates:
#   1. ensure age + key + recipients exist (operator setup is documented)
#   2. ensure secrets/<slug>.env.age exists (interactive init if not)
#   3. terraform apply (Hetzner VPS + Cloudflare DNS + firewall)
#   4. wait for SSH + cloud-init to finish
#   5. wait for DNS to propagate
#   6. decrypt secrets, bcrypt-hash dashboard password
#   7. render Caddyfile + .env (hash + provider keys)
#   8. rsync compose/ to /opt/hermes-client/compose/
#   9. docker compose pull + up -d on the VPS
#   10. wait for HTTPS to come up with a real LE cert
#   11. smoke-test.sh
#   12. append-inventory.sh + print URL/SSH (NO plaintext password)
#
# Idempotent: rerunning against an existing slug is a no-op for unchanged
# inputs. Secrets stored in secrets/<slug>.env.age are reused; dashboard
# password is stable across deploys.
#
# Usage:
#   bin/deploy-client <slug> --domain example.com [flags]
#
# Required env:
#   HCLOUD_TOKEN           Hetzner Cloud API token
#   CLOUDFLARE_API_TOKEN   Cloudflare API token (Zone:Read, DNS:Edit)
#
# Optional env (consumed only during first-time init of secrets/<slug>.env.age):
#   OPENAI_API_KEY         seed value, prompted if absent
#   ANTHROPIC_API_KEY      seed value, prompted if absent
#   OPENAI_BASE_URL        optional OpenAI-compatible endpoint override

set -euo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"

usage() {
  cat >&2 <<EOF
Usage: $0 <slug> --domain DOMAIN [flags]

Required:
  slug                    Client slug (3-32 lowercase alnum/hyphen)
  --domain DOMAIN         Parent domain in Cloudflare

Flags:
  --location LOC          Hetzner location (default: nbg1)
  --size TYPE             Hetzner server type (default: cx22)
  --image-tag TAG         Inventory tag (default: m3-age)
  --hermes-image REF      Hermes image (default: pinned SHA, see compose/.env.example)
  --dashboard-username U  Basic-auth username for dashboard (default: ops)
  --acme-email EMAIL      Let's Encrypt contact (default: ops+<slug>@<domain>)
  --cloudflare-zone-id ID Cloudflare Zone ID (required unless in tfvars)
  --skip-smoke            Skip smoke tests
  --plan-only             terraform plan, then exit

Env required:  HCLOUD_TOKEN, CLOUDFLARE_API_TOKEN
Env optional:  OPENAI_API_KEY / ANTHROPIC_API_KEY (only used during first-time
               secret init for this slug; on subsequent deploys the values come
               from secrets/<slug>.env.age and these env vars are ignored)
               OPENAI_BASE_URL is passed through to the VPS-side Compose env.

Secrets live in secrets/<slug>.env.age, age-encrypted. See secrets/README.md
for the one-time operator setup (age-keygen + adding your key to .recipients).
EOF
  exit 2
}

# --- arg parsing ---
[[ $# -ge 1 ]] || usage
SLUG="$1"; shift

DOMAIN=""
LOCATION="nbg1"
SIZE="cx22"
IMAGE_TAG="m3-age"
HERMES_IMAGE_DEFAULT="nousresearch/hermes-agent:sha-d9b6f75c0b0ffa3cdb3cbe63de3a8e1a5aa44e8f"
HERMES_IMAGE="$HERMES_IMAGE_DEFAULT"
DASHBOARD_USERNAME="ops"
ACME_EMAIL=""
CF_ZONE_ID=""
SEED_OPENAI_KEY="${OPENAI_API_KEY:-}"
SEED_ANTHROPIC_KEY="${ANTHROPIC_API_KEY:-}"
SKIP_SMOKE=0
PLAN_ONLY=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --domain)              DOMAIN="$2"; shift 2 ;;
    --location)            LOCATION="$2"; shift 2 ;;
    --size)                SIZE="$2"; shift 2 ;;
    --image-tag)           IMAGE_TAG="$2"; shift 2 ;;
    --hermes-image)        HERMES_IMAGE="$2"; shift 2 ;;
    --dashboard-username)  DASHBOARD_USERNAME="$2"; shift 2 ;;
    --acme-email)          ACME_EMAIL="$2"; shift 2 ;;
    --cloudflare-zone-id)  CF_ZONE_ID="$2"; shift 2 ;;
    --skip-smoke)          SKIP_SMOKE=1; shift ;;
    --plan-only)           PLAN_ONLY=1; shift ;;
    -h|--help)             usage ;;
    *) fatal "unknown arg: $1" ;;
  esac
done

# --- validation ---
validate_slug "$SLUG"
[[ -n "$DOMAIN" ]] || fatal "--domain is required"
validate_domain "$DOMAIN"
require_env HCLOUD_TOKEN CLOUDFLARE_API_TOKEN
require_cmd terraform ssh scp rsync dig curl openssl jq

FQDN="${SLUG}.${DOMAIN}"
ACME_EMAIL="${ACME_EMAIL:-ops+${SLUG}@${DOMAIN}}"

info "slug=$SLUG fqdn=$FQDN location=$LOCATION size=$SIZE image_tag=$IMAGE_TAG"

# --- 0. age preflight + secrets init ---
require_age

if ! age_secret_exists "$SLUG"; then
  info "no encrypted secrets for $SLUG — initialising secrets/$SLUG.env.age"

  # Generate a stable dashboard password for this slug — it lives encrypted in
  # the .env.age and is reused on every deploy. Operator captures it once via
  # the encrypted file (decrypt + read), not via shell output.
  init_password="$(gen_password 24)"

  if [[ -z "$SEED_OPENAI_KEY" && -z "$SEED_ANTHROPIC_KEY" ]]; then
    if [[ -t 0 ]]; then
      echo "" >&2
      warn "no LLM provider key in env. Paste one now (it will be encrypted into the .env.age and never logged)."
      printf '  OPENAI_API_KEY (leave blank to skip): ' >&2
      read -rs SEED_OPENAI_KEY; echo "" >&2
      printf '  ANTHROPIC_API_KEY (leave blank to skip): ' >&2
      read -rs SEED_ANTHROPIC_KEY; echo "" >&2
    fi
  fi
  if [[ -z "$SEED_OPENAI_KEY" && -z "$SEED_ANTHROPIC_KEY" ]]; then
    fatal "at least one of OPENAI_API_KEY / ANTHROPIC_API_KEY must be provided (via env or interactive prompt)"
  fi

  init_plain="$(mktemp)"
  trap 'shred_file "$init_plain"' EXIT
  cat > "$init_plain" <<EOF
# Encrypted secrets for $SLUG. Decrypt with:
#   age -d -i ~/.config/age/operator.key secrets/$SLUG.env.age
HERMES_DASHBOARD_PASSWORD=$init_password
OPENAI_API_KEY=$SEED_OPENAI_KEY
ANTHROPIC_API_KEY=$SEED_ANTHROPIC_KEY
EOF
  age_encrypt_secret "$SLUG" "$init_plain"
  shred_file "$init_plain"
  trap - EXIT

  ok "wrote $(age_secret_path "$SLUG")"
  warn "remember to: git add $(age_secret_path "$SLUG") && git commit -m 'ops: init $SLUG secrets'"
fi

# --- 0b. decrypt secrets to ephemeral file, sourced into the script's env ---
plain="$(mktemp)"
trap 'shred_file "$plain"; rm -rf "${RENDER_DIR:-}"' EXIT
chmod 600 "$plain"
age_decrypt_secret "$SLUG" > "$plain"
# shellcheck disable=SC1090
set -a; source "$plain"; set +a

[[ -n "${HERMES_DASHBOARD_PASSWORD:-}" ]] || fatal "secrets/$SLUG.env.age missing HERMES_DASHBOARD_PASSWORD"
[[ -n "${OPENAI_API_KEY:-}" || -n "${ANTHROPIC_API_KEY:-}" ]] \
  || fatal "secrets/$SLUG.env.age missing both OPENAI_API_KEY and ANTHROPIC_API_KEY"

# --- preflight: DNS collision check ---
existing="$(dig +short @1.1.1.1 "$FQDN" A | tail -n1 || true)"
if [[ -n "$existing" ]]; then
  warn "$FQDN already resolves to $existing — assuming re-deploy of same slug"
fi

# --- 1. terraform apply ---
INFRA_DIR="$REPO_ROOT/infra"
TFVARS_FILE="$INFRA_DIR/terraform.tfvars"
[[ -f "$TFVARS_FILE" ]] || fatal "missing $TFVARS_FILE — copy terraform.tfvars.example and fill in"

info "terraform init"
terraform -chdir="$INFRA_DIR" init -input=false >/dev/null

TF_VAR_ARGS=(
  -var "slug=$SLUG"
  -var "domain=$DOMAIN"
  -var "hcloud_location=$LOCATION"
  -var "hcloud_server_type=$SIZE"
  -var "image_tag=$IMAGE_TAG"
)
[[ -n "$CF_ZONE_ID" ]] && TF_VAR_ARGS+=(-var "cloudflare_zone_id=$CF_ZONE_ID")

if [[ "$PLAN_ONLY" -eq 1 ]]; then
  info "terraform plan (--plan-only)"
  terraform -chdir="$INFRA_DIR" plan -input=false "${TF_VAR_ARGS[@]}"
  exit 0
fi

info "terraform apply"
terraform -chdir="$INFRA_DIR" apply -input=false -auto-approve "${TF_VAR_ARGS[@]}"

IPV4="$(terraform -chdir="$INFRA_DIR" output -raw ipv4)"
SSH_HOST="$(terraform -chdir="$INFRA_DIR" output -raw ssh_host)"
OUT_FQDN="$(terraform -chdir="$INFRA_DIR" output -raw fqdn)"
[[ "$OUT_FQDN" == "$FQDN" ]] || fatal "fqdn mismatch: tf=$OUT_FQDN expected=$FQDN"

ok "vps ready: $SSH_HOST ($IPV4)"

# --- 2. wait for ssh + cloud-init ---
"$REPO_ROOT/scripts/wait-for-ssh.sh" "$SSH_HOST"

# --- 3. wait for DNS propagation ---
"$REPO_ROOT/scripts/wait-for-dns.sh" "$FQDN" "$IPV4"

# --- 4. hash dashboard password ---
info "bcrypt-hashing dashboard password (via disposable caddy container)"
DASHBOARD_PASSWORD_HASH="$(hash_password_caddy "$HERMES_DASHBOARD_PASSWORD")"
[[ -n "$DASHBOARD_PASSWORD_HASH" ]] || fatal "caddy hash-password produced empty hash (is docker running locally?)"
DASHBOARD_PASSWORD_HASH_ESCAPED="$(escape_compose_env_value "$DASHBOARD_PASSWORD_HASH")"

# --- 5. render templates ---
RENDER_DIR="$(mktemp -d)"

info "rendering Caddyfile + .env"
sed \
  -e "s|{{FQDN}}|$FQDN|g" \
  -e "s|{{ACME_EMAIL}}|$ACME_EMAIL|g" \
  "$REPO_ROOT/compose/Caddyfile.tmpl" > "$RENDER_DIR/Caddyfile"

cat > "$RENDER_DIR/.env" <<EOF
COMPOSE_SLUG=$SLUG
FQDN=$FQDN
ACME_EMAIL=$ACME_EMAIL
HERMES_IMAGE=$HERMES_IMAGE
HERMES_UID=10000
HERMES_GID=10000
HERMES_PROFILE=$SLUG
HERMES_DASHBOARD_USERNAME=$DASHBOARD_USERNAME
HERMES_DASHBOARD_PASSWORD_HASH=$DASHBOARD_PASSWORD_HASH_ESCAPED
OPENAI_API_KEY=${OPENAI_API_KEY:-}
OPENAI_BASE_URL=${OPENAI_BASE_URL:-}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}
EOF
chmod 600 "$RENDER_DIR/.env"

# --- 6. rsync compose/ + rendered files ---
info "syncing compose stack to $SSH_HOST"
rsync -az --delete \
  --exclude '.env' \
  --exclude 'Caddyfile' \
  --exclude 'Caddyfile.local' \
  --exclude '.env.example' \
  --exclude 'docker-compose.local.yml' \
  -e "ssh -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR" \
  "$REPO_ROOT/compose/" \
  "$SSH_HOST:/opt/hermes-client/compose/"

scp_remote "$RENDER_DIR/Caddyfile" "$SSH_HOST:/opt/hermes-client/compose/Caddyfile"
scp_remote "$RENDER_DIR/.env"      "$SSH_HOST:/opt/hermes-client/compose/.env"
ssh_remote "$SSH_HOST" "chmod 600 /opt/hermes-client/compose/.env"

# --- 7. docker compose up -d ---
info "docker compose pull + up -d (first pull on a fresh VPS is ~1 GB)"
ssh_remote "$SSH_HOST" "cd /opt/hermes-client/compose && sudo docker compose pull --quiet && sudo docker compose up -d --remove-orphans"

# --- 8. wait for HTTPS ---
"$REPO_ROOT/scripts/wait-for-https.sh" "https://$FQDN/health"

# --- 9. smoke tests ---
if [[ "$SKIP_SMOKE" -eq 1 ]]; then
  warn "smoke tests skipped"
else
  "$REPO_ROOT/scripts/smoke-test.sh" "$FQDN" --ssh-host "$SSH_HOST"
fi

# --- 10. inventory ---
"$REPO_ROOT/scripts/append-inventory.sh" "$SLUG" "$FQDN" "$IPV4" "$IMAGE_TAG"

# --- final output. NO plaintext password — it's in the encrypted file. ---
ok "deploy complete"
info "URL:        https://$FQDN/"
info "SSH:        ssh $SSH_HOST"
info "username:   $DASHBOARD_USERNAME"
info "password:   stored in $(age_secret_path "$SLUG")"
info ""
info "to read the password:"
info "  age -d -i ~/.config/age/operator.key $(age_secret_path "$SLUG") | grep HERMES_DASHBOARD_PASSWORD"
info ""
info "next: review docs/client-inventory.md, commit, push"
